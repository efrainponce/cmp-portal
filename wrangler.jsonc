{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmp-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/wa/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cmp-portal",
      "database_id": "babdcd7e-a3df-4350-a1fa-8db4722f3862"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mexicanadeproteccion"
    }
  ],
  "triggers": {
    "crons": ["0 0,12 * * *", "*/10 * * * *", "*/15 * * * *", "0 9 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "prod",
    "CMP_TALLAS_BASE": "https://cmp-tallas.vercel.app",
    "ACCESS_TEAM_DOMAIN": "mexicanaproteccion.cloudflareaccess.com",
    "ACCESS_AUD": "f0501e543254e1d671d2b6830e28edb1cb79b340131918ddfc05728cf4785296",
    "DRIVE_PROYECTOS": "1"
  },
  "preview_urls": false,
  // Smart Placement (2026-09-30, docs/plan-performance.md): el worker corre
  // junto a la D1 (WNAM) en vez de junto al usuario — cada request hace varias
  // consultas en serie y cada una cruzaba de México/Texas a EE.UU. oeste. Los
  // estáticos (/assets) no pasan por el worker y se siguen sirviendo desde el
  // borde. Cloudflare solo lo mueve si mide que conviene; el header
  // `cf-placement` dice dónde corrió. Para regresarlo, borrar este bloque.
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
